# Build output (CARGO_TARGET_DIR is normally redirected outside the repo, but a
# plain `cargo build` in this folder would create ./target).
/target/

# Development signing key material (never commit/package a PFX).
/dev-signing/

# Release assemblies and the packaged ZIP: regenerated by the release steps.
/dist/

# Intermediate recording fragments. These are produced at runtime next to the
# executable / in the config folder; they are never source.
/Cache/
/cap-recordings/

# Runtime config and log (created in the config folder when CapLite runs from here).
/cap.log
/config.json

# Regenerable Python bytecode from the scripts/ helpers.
/scripts/__pycache__/
__pycache__/
*.pyc

# Third-party toolchains: large, replaceable build inputs (NOT vendored).
# _llvm = libclang for ffmpeg-sys-next bindgen; ffmpeg-n9... = FFmpeg 9.0 LGPL
# shared build (headers + import libs + DLL names). See README for how to fetch.
/_llvm/
/ffmpeg-n9.0-latest-win64-lgpl-shared-9.0/

# Manual test scratch (release exe copies, recorded fragments, openh264 DLL copies).
/manual-test/

# Smoke-test evidence artifacts under _rust/.
/_rust/
